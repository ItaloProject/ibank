# Copie este arquivo para .env.local e preencha com seus valores

# Supabase PostgreSQL - Use a connection string do pooler em modo transação (porta 6543)
# Obtenha em https://supabase.com/dashboard (Project Settings → Database)
DATABASE_URL=postgresql://postgres.<project-ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:6543/postgres

# Auth — obrigatório em produção
JWT_SECRET=gere-um-segredo-longo-aleatorio
DEFAULT_PASSWORD=  # only for one-time /api/auth/setup

# E-mail de alerta (Resend Free: 100/dia). Sem RESEND_API_KEY o app só registra o bloqueio na tela.
# 1) Crie a conta em https://resend.com → API Keys
# 2) Domains → adicione muvo.dev.br (SPF/DKIM no DNS)
# 3) EMAIL_FROM com endereço desse domínio; EMAIL_ALERTA_ADMIN recebe cópia de todo bloqueio
RESEND_API_KEY=
EMAIL_FROM=MUVO <seguranca@muvo.dev.br>
EMAIL_ALERTA_ADMIN=

# WhatsApp para venda por pedido (somente dígitos com DDI, ex.: 5511999999999)
NEXT_PUBLIC_WHATSAPP=5511999999999

# Opcional — token gratuito em https://brapi.dev (expande indicadores de FIIs além do sandbox MXRF11/HGLG11)
# BRAPI_TOKEN=

# Entrar com o Google (Google Cloud Console → APIs e serviços → Credenciais → ID do cliente OAuth).
# GOOGLE_CLIENT_IDS: IDs aceitos pelo servidor, separados por vírgula (o do tipo "Web" e, se usar, o do Android).
# NEXT_PUBLIC_GOOGLE_CLIENT_ID: o ID do tipo "Web", para o botão do site. Sem eles, o botão não aparece.
GOOGLE_CLIENT_IDS=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Google Play Billing (assinaturas dentro do app Android).
# GOOGLE_PLAY_PACKAGE_NAME: pacote do app na Play Store (padrão com.muvo.app).
# GOOGLE_PLAY_SERVICE_ACCOUNT_JSON: JSON da conta de serviço com acesso à API de publicação (ou em base64).
# GOOGLE_PLAY_RTDN_AUDIENCE / GOOGLE_PLAY_RTDN_SERVICE_ACCOUNT: URL de /api/billing/google-play/rtdn e o e-mail da conta
# de serviço configurada na assinatura push do Pub/Sub (assim só o Google consegue chamar a rota).
GOOGLE_PLAY_PACKAGE_NAME=com.muvo.app
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_RTDN_AUDIENCE=
GOOGLE_PLAY_RTDN_SERVICE_ACCOUNT=
