# Copie este arquivo para .env.local e preencha com seus valores

# Neon DB - Obtenha em https://console.neon.tech
DATABASE_URL=postgresql://usuario:senha@host/neondb?sslmode=require

# Auth — obrigatório em produção
JWT_SECRET=gere-um-segredo-longo-aleatorio
DEFAULT_PASSWORD=  # only for one-time /api/auth/setup

# WhatsApp para venda por pedido (somente dígitos com DDI, ex.: 5511999999999)
NEXT_PUBLIC_WHATSAPP=5511999999999

# Opcional — token gratuito em https://brapi.dev (expande indicadores de FIIs além do sandbox MXRF11/HGLG11)
# BRAPI_TOKEN=
